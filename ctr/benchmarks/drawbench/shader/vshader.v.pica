; drawbench vertex shader: position (x, y, z) and texcoord (u, v),
; offset by a uniform and transformed by a 4x4 projection matrix.

.fvec projection[4]
.fvec offset

.constf ones(1.0, 1.0, 1.0, 1.0)
.alias  one ones.x

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc  v1

.proc main
	; r0 = (inpos.xyz + offset.xyz, 1.0)
	add r0.xyz, offset.xyz, inpos.xyz   ; a uniform may only be the first source here
	mov r0.w,   one

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intc
	mov outclr, ones
	end
.end
